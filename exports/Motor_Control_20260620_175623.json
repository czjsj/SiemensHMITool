  "scripts": [
    {
      "name": "Sub_Start_Press",
      "language": "VBS",
      "purpose": "启动按钮按下时置位启动命令",
      "code": "' 启动按钮按下\nSmartTags(\"Motor_StartCmd\") = 1"
    },
    {
      "name": "Sub_Start_Release",
      "language": "VBS",
      "purpose": "启动按钮释放时复位启动命令",
      "code": "' 启动按钮释放\nSmartTags(\"Motor_StartCmd\") = 0"
    },
    {
      "name": "Sub_Stop_Press",
      "language": "VBS",
      "purpose": "停止按钮按下时置位停止命令",
      "code": "' 停止按钮按下\nSmartTags(\"Motor_StopCmd\") = 1"
    },
    {
      "name": "Sub_Stop_Release",
      "language": "VBS",
      "purpose": "停止按钮释放时复位停止命令",
      "code": "' 停止按钮释放\nSmartTags(\"Motor_StopCmd\") = 0"
    },
    {
      "name": "Sub_Reset_Press",
      "language": "VBS",
      "purpose": "复位按钮按下时置位复位命令",
      "code": "' 复位按钮按下\nSmartTags(\"Motor_ResetCmd\") = 1"
    },
    {
      "name": "Sub_Reset_Release",
      "language": "VBS",
      "purpose": "复位按钮释放时复位复位命令",
      "code": "' 复位按钮释放\nSmartTags(\"Motor_ResetCmd\") = 0"
    },
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 BTN_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"BTN_Start\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 BTN_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"BTN_Start\") = 0"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 BTN_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"BTN_Stop\") = 1"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 BTN_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"BTN_Stop\") = 0"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 BTN_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"BTN_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 BTN_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"BTN_Reset\") = 0"
    }
  ],
