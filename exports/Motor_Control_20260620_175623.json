{
  "meta": {
    "screen_name": "Motor_Control",
    "title": "电机控制画面",
    "description": "电机启停控制：启动/停止/复位按钮，运行与故障指示灯（故障闪烁），显示转速和运行模式。假设转速为Real，模式为Int（0停止/1手动/2自动）。采用800x480分辨率布局。根据审查修正布局对齐问题。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
