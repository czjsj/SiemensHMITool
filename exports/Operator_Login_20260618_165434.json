  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名密码，匹配则置位在线状态并提示成功，否则提示错误",
      "code": "' 登录校验\nDim sUser, sPass\nsUser = SmartTags(\"User_Name\")\nsPass = SmartTags(\"User_Password\")\n' 硬编码校验 admin / 123456\nIf sUser = \"admin\" And sPass = \"123456\" Then\n    SmartTags(\"LoginActive\") = True\n    HMIRuntime.OutputSystemAlarm \"登录成功\", 1\nElse\n    SmartTags(\"LoginActive\") = False\n    HMIRuntime.OutputSystemAlarm \"用户名或密码错误\", 1\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录：清除在线状态并提示",
      "code": "' 退出登录\nSmartTags(\"LoginActive\") = False\nHMIRuntime.OutputSystemAlarm \"已退出\", 1"
    }
  ],
  "_warnings": [],
