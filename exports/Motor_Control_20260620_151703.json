  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "启动按钮辅助：复位停止标志",
      "code": "' 启动按钮辅助逻辑（主动作由behavior完成）\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "停止按钮辅助：复位启动标志",
      "code": "' 停止按钮辅助逻辑\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 BTN_BTN_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"BTN_BTN_Start\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 BTN_BTN_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"BTN_BTN_Start\") = 0"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 BTN_BTN_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"BTN_BTN_Stop\") = 1"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 BTN_BTN_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"BTN_BTN_Stop\") = 0"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 BTN_BTN_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"BTN_BTN_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 BTN_BTN_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"BTN_BTN_Reset\") = 0"
    }
