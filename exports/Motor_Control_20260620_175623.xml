      </Tag>
      <Tag Name="IO_Speed" DataType="Real">
        <Comment>自动生成 — None</Comment>
      </Tag>
      <Tag Name="SIO_Mode" DataType="Real">
        <Comment>自动生成 — None</Comment>
      </Tag>
    </Tags>
