  <VBScripts>
    
      <Purpose>启动按钮按下时置位启动命令</Purpose>
      
        ' 启动按钮按下
SmartTags("Motor_StartCmd") = 1
      
    
    
      <Purpose>启动按钮释放时复位启动命令</Purpose>
      
        ' 启动按钮释放
SmartTags("Motor_StartCmd") = 0
      
    
    
      <Purpose>停止按钮按下时置位停止命令</Purpose>
      
        ' 停止按钮按下
SmartTags("Motor_StopCmd") = 1
      
    
    
      <Purpose>停止按钮释放时复位停止命令</Purpose>
      
        ' 停止按钮释放
SmartTags("Motor_StopCmd") = 0
      
    
    
      <Purpose>复位按钮按下时置位复位命令</Purpose>
      
        ' 复位按钮按下
SmartTags("Motor_ResetCmd") = 1
      
    
    
      <Purpose>复位按钮释放时复位复位命令</Purpose>
      
        ' 复位按钮释放
SmartTags("Motor_ResetCmd") = 0
      
    
    
      <Purpose>按钮「启动」— 按下置位 BTN_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("BTN_Start") = 1
      
    
    
      <Purpose>按钮「启动」— 释放复位 BTN_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("BTN_Start") = 0
      
    
    
      <Purpose>按钮「停止」— 按下置位 BTN_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("BTN_Stop") = 1
      
    
    
      <Purpose>按钮「停止」— 释放复位 BTN_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("BTN_Stop") = 0
      
    
    
      <Purpose>按钮「复位」— 按下置位 BTN_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("BTN_Reset") = 1
      
    
    
      <Purpose>按钮「复位」— 释放复位 BTN_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("BTN_Reset") = 0
      
    
  </VBScripts>
