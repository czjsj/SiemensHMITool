  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名和密码，成功则置位登录状态并提示，失败则提示错误",
      "code": "' 登录校验：用户名 admin，密码 123456\nDim sUser, sPass\nsUser = SmartTags(\"User_Name\")\nsPass = SmartTags(\"User_Password\")\nIf sUser = \"admin\" And sPass = \"123456\" Then\n    SmartTags(\"Login_Status\") = True\n    HMIRuntime.Trace \"登录成功\"\n    ShowSystemAlarm \"登录成功！\"\nElse\n    SmartTags(\"Login_Status\") = False\n    ShowSystemAlarm \"用户名或密码错误！\"\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录，清除登录状态并提示",
      "code": "' 退出登录\nSmartTags(\"Login_Status\") = False\nSmartTags(\"User_Name\") = \"\"\nSmartTags(\"User_Password\") = \"\"\nShowSystemAlarm \"已退出登录！\""
    }
  ],
