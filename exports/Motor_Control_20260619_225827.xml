  <VBScripts>
    
      <Purpose>按下启动按钮：置位启动，复位停止</Purpose>
      
        SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>按下停止按钮：置位停止，复位启动</Purpose>
      
        SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>按下复位按钮：触发故障复位</Purpose>
      
        SmartTags("Motor_Reset") = 1
      
    
    
      <Purpose>按钮「启动」— 按下置位 BTN_BTN_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("BTN_BTN_Start") = 1
      
    
    
      <Purpose>按钮「启动」— 释放复位 BTN_BTN_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("BTN_BTN_Start") = 0
      
    
    
      <Purpose>按钮「停止」— 按下置位 BTN_BTN_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("BTN_BTN_Stop") = 1
      
    
    
      <Purpose>按钮「停止」— 释放复位 BTN_BTN_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("BTN_BTN_Stop") = 0
      
    
    
      <Purpose>按钮「复位」— 按下置位 BTN_BTN_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("BTN_BTN_Reset") = 1
      
    
    
      <Purpose>按钮「复位」— 释放复位 BTN_BTN_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("BTN_BTN_Reset") = 0
      
    
  </VBScripts>
</Document>