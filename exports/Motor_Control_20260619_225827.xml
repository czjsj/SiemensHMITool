      </Tag>
      <Tag Name="STS_LMP_Run" DataType="Bool">
        <Comment>自动生成 — 运行（状态指示）</Comment>
      </Tag>
      <Tag Name="LMP_LMP_Fault" DataType="Bool">
        <Comment>自动生成 — 故障（报警/故障指示）</Comment>
      </Tag>
    </Tags>
