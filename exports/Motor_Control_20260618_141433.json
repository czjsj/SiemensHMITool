      "address": "%M0.1",
      "comment": "停止命令"
    },
    {
      "name": "Motor_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "复位命令"
    },
    {
      "name": "Motor_Running",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行反馈"
    },
    {
      "name": "Motor_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障反馈"
    },
    {
      "name": "Motor_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "转速"
    },
    {
      "name": "Motor_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式（0停止，1手动，2自动）"
    }
  ],
  "text_lists": [
