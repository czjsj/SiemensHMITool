  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "启动按钮按下，置位启动命令，复位停止命令",
      "code": "' 启动按钮\nSmartTags(\"Motor_Start\") = 1\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "停止按钮按下，置位停止命令，复位启动命令",
      "code": "' 停止按钮\nSmartTags(\"Motor_Stop\") = 1\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "复位按钮按下，置位复位命令",
      "code": "' 复位按钮\nSmartTags(\"Motor_Reset\") = 1"
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
