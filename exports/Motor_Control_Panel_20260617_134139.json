{
  "meta": {
    "screen_name": "Motor_Control_Panel",
    "title": "电机控制画面",
    "description": "电机启停控制：三个按钮（启动、停止、复位），一个运行指示灯（绿色），一个故障指示灯（红色闪烁），转速显示（rpm），运行模式显示（停止/手动/自动）。假设变量已定义。分辨率1280x800。",
    "resolution": "1280x800",
    "hmi_type": "Comfort"
  },
  "tags": [
    {
      "name": "Start_Cmd",
      "data_type": "Bool",
      "address": "%M10.0",
      "comment": "启动命令"
    },
    {
      "name": "Stop_Cmd",
      "data_type": "Bool",
      "address": "%M10.1",
      "comment": "停止命令"
    },
    {
      "name": "Reset_Cmd",
      "data_type": "Bool",
      "address": "%M10.2",
      "comment": "复位命令"
    },
    {
      "name": "Run_Status",
      "data_type": "Bool",
      "address": "%M10.3",
      "comment": "运行状态"
    },
    {
      "name": "Fault_Status",
      "data_type": "Bool",
      "address": "%M10.4",
      "comment": "故障状态"
    },
    {
      "name": "Speed_Act",
      "data_type": "Real",
      "address": "%MD20",
      "comment": "实际转速"
    },
    {
      "name": "Mode_Select",
      "data_type": "Int",
      "address": "%MW30",
      "comment": "运行模式(0停止/1手动/2自动)"
    }
  ],
  "text_lists": [
    {
      "name": "Mode_Text_List",
      "entries": [
        {
          "value": 0,
          "text": "停止"
        },
        {
          "value": 1,
          "text": "手动"
        },
        {
          "value": 2,
          "text": "自动"
        }
      ]
    }
  ],
  "objects": [
    {
      "id": "TXT_Title",
      "type": "Text",
      "x": 460,
      "y": 30,
      "width": 360,
      "height": 44,
      "text": "电机控制画面",
      "font_size": 26,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "BTN_Start",
      "type": "Button",
      "x": 100,
      "y": 120,
      "width": 140,
      "height": 56,
      "text": "启动",
      "press_script": "Sub_StartCmd",
      "release_script": null,
      "click_script": null,
      "background_color": "#2BB673"
    },
    {
      "id": "BTN_Stop",
      "type": "Button",
      "x": 280,
      "y": 120,
      "width": 140,
      "height": 56,
      "text": "停止",
      "press_script": "Sub_StopCmd",
      "release_script": null,
      "click_script": null,
      "background_color": "#E25563"
    },
    {
      "id": "BTN_Reset",
      "type": "Button",
      "x": 460,
      "y": 120,
      "width": 140,
      "height": 56,
      "text": "复位",
      "press_script": "Sub_ResetCmd",
      "release_script": null,
      "click_script": null,
      "background_color": "#3A4250"
    },
    {
      "id": "LMP_Run",
      "type": "Indicator",
      "x": 700,
      "y": 128,
      "radius": 22,
      "process_tag": "Run_Status",
      "color_on": "#27D17F",
      "color_off": "#3A4250",
      "blink": false,
      "label": "运行"
    },
    {
      "id": "LMP_Fault",
      "type": "Indicator",
      "x": 840,
      "y": 128,
      "radius": 22,
      "process_tag": "Fault_Status",
      "color_on": "#E25563",
      "color_off": "#3A4250",
      "blink": true,
      "label": "故障"
    },
    {
      "id": "IO_Speed",
      "type": "IOField",
      "x": 280,
      "y": 300,
      "width": 160,
      "height": 44,
      "mode": "Output",
      "process_tag": "Speed_Act",
      "font_size": 18,
      "label": "转速",
      "display_format": "Decimal",
      "decimal_digits": 0,
      "unit": "rpm"
    },
    {
      "id": "SIO_Mode",
      "type": "SymbolicIOField",
      "x": 280,
      "y": 380,
      "width": 160,
      "height": 44,
      "mode": "Output",
      "process_tag": "Mode_Select",
      "font_size": 18,
      "label": "运行模式",
      "text_list": "Mode_Text_List"
    }
  ],
  "scripts": [
    {
      "name": "Sub_StartCmd",
      "language": "VBS",
      "purpose": "按下启动按钮，设置启动命令，复位停止命令",
      "code": "' 启动按钮按下\nSmartTags(\"Start_Cmd\") = 1\nSmartTags(\"Stop_Cmd\") = 0"
    },
    {
      "name": "Sub_StopCmd",
      "language": "VBS",
      "purpose": "按下停止按钮，设置停止命令，复位启动命令",
      "code": "' 停止按钮按下\nSmartTags(\"Stop_Cmd\") = 1\nSmartTags(\"Start_Cmd\") = 0"
    },
    {
      "name": "Sub_ResetCmd",
      "language": "VBS",
      "purpose": "按下复位按钮，置位复位命令（持续脉冲）",
      "code": "' 复位按钮按下：触发复位\nSmartTags(\"Reset_Cmd\") = 1"
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
}