      </Geometry>
      <Properties>
      <Text>
        <ID>201626a6-aed4-43e2-a88a-af9e676cd700</ID>
        <MultilingualText>
  <Text Language="zh-CN">复位</Text>
</MultilingualText>
      </Text>
      <BackColor>58,66,80</BackColor>
      </Properties>
      <Connection>
      <ProcessTag>Motor_Reset</ProcessTag>
      </Connection>
      </ScreenItem>
      <ScreenItem ID="430c3a0a-af5a-4329-a656-9a5a0402d8b2" Name="LMP_Run" Type="Circle">
      <Geometry>
      <X>250</X>
      <Y>184</Y>
      <Width>44</Width>
      <Height>44</Height>
      </Geometry>
      <Properties>
      <FillColor>58,66,80</FillColor>
      <BorderColor>120,130,140</BorderColor>
      </Properties>
      <Animations>
      <ColorAnimation Tag="Motor_Running">
      <Range Value="0" FillColor="58,66,80" />
      <Range Value="1" FillColor="39,209,127" />
      </ColorAnimation>
      </Animations>
      </ScreenItem>
      <ScreenItem ID="2a1416f6-71b8-4e4b-8cb4-896ce20c6486" Name="LMP_Fault" Type="Circle">
      <Geometry>
      <X>400</X>
      <Y>184</Y>
      <Width>44</Width>
      <Height>44</Height>
      </Geometry>
      <Properties>
      <FillColor>58,66,80</FillColor>
      <BorderColor>120,130,140</BorderColor>
      </Properties>
      <Animations>
      <ColorAnimation Tag="Motor_Fault">
      <Range Value="0" FillColor="58,66,80" />
      <Range Value="1" FillColor="226,85,99" />
      </ColorAnimation>
      <FlashAnimation Tag="Motor_Fault">
      <Range Value="1" Flashing="Yes" />
      </FlashAnimation>
      </Animations>
      </ScreenItem>
      <ScreenItem ID="0d1a728b-629b-4b00-aec0-210f261dc3ed" Name="IO_Speed" Type="IOField">
      <Geometry>
      <X>200</X>
      <Y>300</Y>
      <Width>170</Width>
      <Height>44</Height>
      </Geometry>
      <Properties>
      <Mode>Output</Mode>
      <OutputFormat>Decimal</OutputFormat>
      <DecimalDigits>0</DecimalDigits>
      <FontSize>18</FontSize>
      </Properties>
      <Connection>
      <ProcessTag>Motor_Speed</ProcessTag>
      </Connection>
      </ScreenItem>
      <ScreenItem ID="25fc552d-262d-48bc-b914-3dac1057a939" Name="SIO_Mode" Type="SymbolicIOField">
      <Geometry>
      <X>430</X>
      <Y>300</Y>
      <Width>170</Width>
      <Height>44</Height>
      </Geometry>
      <Properties>
      <Mode>Output</Mode>
      <FontSize>18</FontSize>
      <TextList>Motor_Mode_List</TextList>
      </Properties>
      <Connection>
      <ProcessTag>Motor_Mode</ProcessTag>
      </Connection>
      </ScreenItem>
    </ObjectList>
  </Screen>
  <VBScripts>
    
      <Purpose>按钮「启动」— 按下置位 Motor_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("Motor_Start") = 1

      
    
    
      <Purpose>按钮「启动」— 释放复位 Motor_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("Motor_Start") = 0

      
    
    
      <Purpose>按钮「停止」— 按下置位 Motor_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("Motor_Stop") = 1

      
    
    
      <Purpose>按钮「停止」— 释放复位 Motor_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("Motor_Stop") = 0

      
    
    
      <Purpose>按钮「复位」— 按下置位 Motor_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("Motor_Reset") = 1

      
    
    
      <Purpose>按钮「复位」— 释放复位 Motor_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("Motor_Reset") = 0

      
    
  </VBScripts>
</Document>