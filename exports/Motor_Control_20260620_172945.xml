<?xml version="1.0" encoding="utf-8"?>
<Document xmlns="http://www.siemens.com/automation/SimaticML">
  <Engineering version="V16" />
  <Screen ID="45901831-445b-444f-9976-12defb297173" Name="Motor_Control">
    <AttributeList>
      <Name>Motor_Control</Name>
      <DisplayName>电机控制画面</DisplayName>
      <Width>800</Width>
      <Height>480</Height>
    </AttributeList>
    <Tags>
      <Tag Name="Motor_Start" DataType="Bool">
        <Address>%M0.0</Address>
        <Comment>启动命令</Comment>
      </Tag>
      <Tag Name="Motor_Stop" DataType="Bool">
        <Address>%M0.1</Address>
        <Comment>停止命令</Comment>
      </Tag>
      <Tag Name="Motor_Reset" DataType="Bool">
        <Address>%M0.2</Address>
        <Comment>故障复位</Comment>
      </Tag>
      <Tag Name="Motor_Running" DataType="Bool">
        <Address>%M0.3</Address>
        <Comment>运行反馈</Comment>
      </Tag>
      <Tag Name="Motor_Fault" DataType="Bool">
        <Address>%M0.4</Address>
        <Comment>故障标志</Comment>
      </Tag>
      <Tag Name="Motor_Speed" DataType="Real">
        <Address>%MD10</Address>
        <Comment>转速 rpm</Comment>
      </Tag>
      <Tag Name="Motor_Mode" DataType="Int">
        <Address>%MW20</Address>
        <Comment>运行模式</Comment>
      </Tag>
    </Tags>
    <TextLists>
      <TextList Name="Motor_Mode_List">
        <Entry Value="0" Text="停止" />
        <Entry Value="1" Text="手动" />
        <Entry Value="2" Text="自动" />
      </TextList>
    </TextLists>
    <ObjectList>
      <ScreenItem ID="24e1b613-7930-45d1-9567-fbbf0ff950f0" Name="TXT_Title" Type="TextField">
      <Geometry>
      <X>200</X>
      <Y>20</Y>
      <Width>400</Width>
      <Height>40</Height>
      </Geometry>
      <Properties>
      <Text>
        <ID>0cf02deb-1658-4225-9fbc-c6915fcc8409</ID>
        <MultilingualText>
  <Text Language="zh-CN">电机控制画面</Text>
</MultilingualText>
      </Text>
      <FontSize>24</FontSize>
      <Bold>true</Bold>
      <ForeColor>230,237,243</ForeColor>
      </Properties>
      </ScreenItem>
      <ScreenItem ID="86291c5d-22d1-4926-a7e2-91068f0fc2ca" Name="BTN_Start" Type="Button">
      <Geometry>
      <X>100</X>
      <Y>90</Y>
      <Width>130</Width>
      <Height>50</Height>
      </Geometry>
      <Properties>
      <Text>
        <ID>28831aa7-9c6b-4b70-b779-914dcad0a808</ID>
        <MultilingualText>
  <Text Language="zh-CN">启动</Text>
</MultilingualText>
      </Text>
      <BackColor>39,209,127</BackColor>
      </Properties>
      <Connection>
      <ProcessTag>Motor_Start</ProcessTag>
      </Connection>
      </ScreenItem>
      <ScreenItem ID="0219794d-b8c8-4225-be83-1a6eacdf3ef8" Name="BTN_Stop" Type="Button">
      <Geometry>
      <X>254</X>
      <Y>90</Y>
      <Width>130</Width>
      <Height>50</Height>
      </Geometry>
      <Properties>
      <Text>
        <ID>1fb64c15-69df-4b0e-9d36-f42d723215b4</ID>
        <MultilingualText>
  <Text Language="zh-CN">停止</Text>
</MultilingualText>
      </Text>
      <BackColor>226,85,99</BackColor>
      </Properties>
      <Connection>
      <ProcessTag>Motor_Stop</ProcessTag>
      </Connection>
      </ScreenItem>
      <ScreenItem ID="32d35991-b774-40e4-b9c9-2a9e6111c794" Name="BTN_Reset" Type="Button">
