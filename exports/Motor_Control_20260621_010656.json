  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "启动按钮按下：置位启动命令，同时复位停止命令",
      "code": "' Sub_Start: 按下启动按钮时执行\nSmartTags(\"Motor_Start\") = 1\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "停止按钮按下：置位停止命令，同时复位启动命令",
      "code": "' Sub_Stop: 按下停止按钮时执行\nSmartTags(\"Motor_Stop\") = 1\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "复位按钮按下：置位复位命令",
      "code": "' Sub_Reset: 按下复位按钮时执行\nSmartTags(\"Motor_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 Motor_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"Motor_Start\") = 1\n"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 Motor_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"Motor_Start\") = 0\n"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 Motor_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"Motor_Stop\") = 1\n"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 Motor_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"Motor_Stop\") = 0\n"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 Motor_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"Motor_Reset\") = 1\n"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 Motor_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"Motor_Reset\") = 0\n"
    }
  ],
