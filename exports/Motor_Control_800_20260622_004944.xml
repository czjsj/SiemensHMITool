      </Tag>
      <Tag Name="BTN_Motor_Stop" DataType="Bool">
        <Address>%M0.1</Address>
        <Comment>停止命令</Comment>
      </Tag>
      <Tag Name="BTN_Motor_Reset" DataType="Bool">
        <Address>%M0.2</Address>
        <Comment>复位命令</Comment>
