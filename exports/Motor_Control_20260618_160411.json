{
  "meta": {
    "screen_name": "Motor_Control",
    "title": "电机控制画面",
    "description": "电机启停控制：启动/停止/复位按钮，运行与故障指示灯（故障闪烁），转速显示（rpm），运行模式显示（停止/手动/自动）。假设变量地址未指定。",
    "resolution": "1280x800",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Motor_Start",
      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动命令"
    },
    {
      "name": "Motor_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止命令"
    },
    {
      "name": "Motor_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "复位命令"
    },
    {
      "name": "Motor_Run",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行反馈"
    },
    {
      "name": "Motor_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障信号"
    },
    {
      "name": "Motor_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "转速值"
    },
    {
      "name": "Motor_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式（0停止/1手动/2自动）"
    }
  ],
  "text_lists": [
    {
      "name": "Motor_Mode_List",
      "entries": [
        {
          "value": 0,
          "text": "停止"
        },
        {
          "value": 1,
          "text": "手动"
        },
        {
          "value": 2,
          "text": "自动"
        }
      ]
    }
  ],
  "objects": [
    {
      "id": "TXT_Title",
      "type": "Text",
      "x": 460,
      "y": 30,
      "width": 360,
      "height": 44,
      "text": "电机控制画面",
      "font_size": 26,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "TXT_Label_Indicator",
      "type": "Text",
      "x": 740,
      "y": 130,
      "width": 60,
      "height": 30,
      "text": "指示灯",
      "font_size": 14,
      "bold": false,
      "color": "#A0AAB8"
    },
    {
      "id": "BTN_Start",
      "type": "Button",
      "x": 120,
      "y": 140,
      "width": 130,
      "height": 56,
      "text": "启动",
      "press_script": "Sub_Start",
      "release_script": null,
      "click_script": null,
      "background_color": "#27D17F"
    },
    {
      "id": "BTN_Stop",
      "type": "Button",
      "x": 280,
      "y": 140,
      "width": 130,
      "height": 56,
      "text": "停止",
      "press_script": "Sub_Stop",
      "release_script": null,
      "click_script": null,
      "background_color": "#E25563"
    },
    {
      "id": "BTN_Reset",
      "type": "Button",
      "x": 440,
      "y": 140,
      "width": 130,
      "height": 56,
      "text": "复位",
      "press_script": "Sub_Reset",
      "release_script": null,
      "click_script": null,
      "background_color": "#3A4250"
    },
    {
      "id": "LMP_Run",
      "type": "Indicator",
      "x": 780,
      "y": 180,
      "radius": 24,
      "process_tag": "Motor_Run",
      "color_on": "#27D17F",
      "color_off": "#3A4250",
      "blink": false,
      "label": "运行"
    },
    {
      "id": "LMP_Fault",
      "type": "Indicator",
      "x": 920,
      "y": 180,
      "radius": 24,
      "process_tag": "Motor_Fault",
      "color_on": "#E25563",
      "color_off": "#3A4250",
      "blink": true,
      "label": "故障"
    },
    {
      "id": "IO_Speed",
      "type": "IOField",
      "x": 280,
      "y": 320,
      "width": 160,
      "height": 44,
      "mode": "Output",
      "process_tag": "Motor_Speed",
      "font_size": 18,
      "label": "转速",
      "display_format": "Decimal",
      "decimal_digits": 0,
      "unit": "rpm"
    },
    {
      "id": "SIO_Mode",
      "type": "SymbolicIOField",
      "x": 280,
      "y": 400,
      "width": 160,
      "height": 44,
      "mode": "Output",
      "process_tag": "Motor_Mode",
      "font_size": 18,
      "label": "运行模式",
      "text_list": "Motor_Mode_List"
    }
  ],
  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "按下启动按钮：置位启动命令，复位停止命令",
      "code": "'启动按钮按下事件\nSmartTags(\"Motor_Start\") = 1\nSmartTags(\"Motor_Stop\") = 0\nSmartTags(\"Motor_Reset\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "按下停止按钮：置位停止命令，复位启动命令",
      "code": "'停止按钮按下事件\nSmartTags(\"Motor_Stop\") = 1\nSmartTags(\"Motor_Start\") = 0\nSmartTags(\"Motor_Reset\") = 0"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "按下复位按钮：置位复位命令（通常为脉冲）",
      "code": "'复位按钮按下事件\nSmartTags(\"Motor_Reset\") = 1\n'复位命令通常由PLC处理为脉冲，此处只做瞬态置位"
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
}