  <VBScripts>
    
      <Purpose>按钮「启动」— 按下置位 BTN_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("BTN_Start") = 1

      
    
    
      <Purpose>按钮「启动」— 释放复位 BTN_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("BTN_Start") = 0

      
    
    
      <Purpose>按钮「停止」— 按下置位 BTN_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("BTN_Stop") = 1

      
    
    
      <Purpose>按钮「停止」— 释放复位 BTN_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("BTN_Stop") = 0

      
    
    
      <Purpose>按钮「复位」— 按下置位 BTN_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("BTN_Reset") = 1

      
    
    
      <Purpose>按钮「复位」— 释放复位 BTN_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("BTN_Reset") = 0

      
    
  </VBScripts>
