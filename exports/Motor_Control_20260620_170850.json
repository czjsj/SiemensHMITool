  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "启动按钮按下：除绑定变量自动置位外，可在此添加额外逻辑",
      "code": "' 启动按钮按下，系统自动置位 Motor_Start（momentary模式）\n' 如需额外操作，在此添加"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "停止按钮按下：除绑定变量自动置位外，可在此添加额外逻辑",
      "code": "' 停止按钮按下，系统自动置位 Motor_Stop（momentary模式）\n' 如需额外操作，在此添加"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "复位按钮按下：除绑定变量自动置位外，可在此添加额外逻辑",
      "code": "' 复位按钮按下，系统自动置位 Motor_Reset（momentary模式）\n' 如需额外操作，在此添加"
    },
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 Motor_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"Motor_Start\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 Motor_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 Motor_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"Motor_Stop\") = 1"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 Motor_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 Motor_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"Motor_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 Motor_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"Motor_Reset\") = 0"
    }
  ],
