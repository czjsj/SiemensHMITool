  <VBScripts>
    
      <Purpose>按下启动按钮：置位启动命令，复位停止命令</Purpose>
      
        ' 启动按钮：发出启动命令
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>按下停止按钮：置位停止命令，复位启动命令</Purpose>
      
        ' 停止按钮：发出停止命令
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>按下复位按钮：置位复位命令</Purpose>
      
        ' 复位按钮：发出故障复位命令
SmartTags("Motor_Reset") = 1
      
    
    
      <Purpose>按钮「启动」— 按下置位 BTN_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("BTN_Start") = 1

      
    
    
      <Purpose>按钮「启动」— 释放复位 BTN_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("BTN_Start") = 0

      
    
    
      <Purpose>按钮「停止」— 按下置位 BTN_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("BTN_Stop") = 1

      
    
    
      <Purpose>按钮「停止」— 释放复位 BTN_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("BTN_Stop") = 0

      
    
    
      <Purpose>按钮「复位」— 按下置位 BTN_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("BTN_Reset") = 1

      
    
    
      <Purpose>按钮「复位」— 释放复位 BTN_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("BTN_Reset") = 0

      
    
  </VBScripts>
