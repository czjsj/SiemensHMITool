  <VBScripts>
    
      <Purpose>校验用户名密码，预设 admin / 123456，正确则置位在线状态并提示，否则提示错误</Purpose>
      
        ' 登录校验脚本
' 读取输入的用户名和密码
Dim sUser, sPwd
sUser = HMIRuntime.Tags("Login_User").Read
sPwd  = HMIRuntime.Tags("Login_Password").Read

' 预设账号密码（实际项目应从用户管理读取）
Const ADMIN_USER = "admin"
Const ADMIN_PWD  = "123456"

If sUser = ADMIN_USER And sPwd = ADMIN_PWD Then
    HMIRuntime.Tags("Login_Online").Write 1
    HMIRuntime.System.ShowSystemAlarm "登录成功"
Else
    HMIRuntime.Tags("Login_Online").Write 0
    HMIRuntime.System.ShowSystemAlarm "用户名或密码错误"
End If
      
    
    
      <Purpose>退出登录：清除在线状态及输入域</Purpose>
      
        ' 退出登录脚本
HMIRuntime.Tags("Login_Online").Write 0
HMIRuntime.Tags("Login_User").Write ""
HMIRuntime.Tags("Login_Password").Write ""
HMIRuntime.System.ShowSystemAlarm "已退出登录"
      
    
  </VBScripts>
