{
  "meta": {
    "screen_name": "Temp_Monitor",
    "title": "温度监控画面",
    "description": "显示三个测点温度（℃）及超温报警指示灯（红色闪烁），一个共用复位报警按钮，系统状态（正常/警告/故障）。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Temperature_1",
      "data_type": "Real",
      "address": "%MD100",
      "comment": "测点1温度"
    },
    {
      "name": "Temperature_2",
      "data_type": "Real",
      "address": "%MD104",
      "comment": "测点2温度"
    },
    {
      "name": "Temperature_3",
      "data_type": "Real",
      "address": "%MD108",
      "comment": "测点3温度"
    },
    {
      "name": "Alarm_1",
      "data_type": "Bool",
      "address": "%M1.0",
      "comment": "测点1超温报警"
    },
    {
      "name": "Alarm_2",
      "data_type": "Bool",
      "address": "%M1.1",
      "comment": "测点2超温报警"
    },
    {
      "name": "Alarm_3",
      "data_type": "Bool",
      "address": "%M1.2",
      "comment": "测点3超温报警"
    },
    {
      "name": "Alarm_Reset",
      "data_type": "Bool",
      "address": "%M1.3",
      "comment": "复位所有报警"
    },
    {
      "name": "System_Status",
      "data_type": "Int",
      "address": "%MW30",
      "comment": "系统状态：0正常/1警告/2故障"
    }
  ],
  "text_lists": [
    {
      "name": "System_Status_List",
      "entries": [
        {
          "value": 0,
          "text": "正常"
        },
        {
          "value": 1,
          "text": "警告"
        },
        {
          "value": 2,
          "text": "故障"
        }
      ]
    }
  ],
  "objects": [
    {
      "id": "TXT_Title",
      "type": "Text",
      "x": 260,
      "y": 20,
      "width": 280,
      "height": 40,
      "text": "温度监控画面",
      "font_size": 22,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "IO_Temp1",
      "type": "IOField",
      "x": 180,
      "y": 85,
      "width": 100,
      "height": 40,
      "mode": "Output",
      "process_tag": "Temperature_1",
      "font_size": 18,
      "label": "测点1温度",
      "display_format": "Decimal",
      "decimal_digits": 1,
      "unit": "℃"
    },
    {
      "id": "LMP_Alarm1",
      "type": "Indicator",
      "x": 340,
      "y": 85,
      "radius": 18,
      "process_tag": "Alarm_1",
      "color_on": "#E25563",
      "color_off": "#3A4250",
      "blink": true,
      "label": "超温"
    },
    {
      "id": "IO_Temp2",
      "type": "IOField",
      "x": 180,
      "y": 155,
      "width": 100,
      "height": 40,
      "mode": "Output",
      "process_tag": "Temperature_2",
      "font_size": 18,
      "label": "测点2温度",
      "display_format": "Decimal",
      "decimal_digits": 1,
      "unit": "℃"
    },
    {
      "id": "LMP_Alarm2",
      "type": "Indicator",
      "x": 340,
      "y": 155,
      "radius": 18,
      "process_tag": "Alarm_2",
      "color_on": "#E25563",
      "color_off": "#3A4250",
      "blink": true,
      "label": "超温"
    },
    {
      "id": "IO_Temp3",
      "type": "IOField",
      "x": 180,
      "y": 225,
      "width": 100,
      "height": 40,
      "mode": "Output",
      "process_tag": "Temperature_3",
      "font_size": 18,
      "label": "测点3温度",
      "display_format": "Decimal",
      "decimal_digits": 1,
      "unit": "℃"
    },
    {
      "id": "LMP_Alarm3",
      "type": "Indicator",
      "x": 340,
      "y": 225,
      "radius": 18,
      "process_tag": "Alarm_3",
      "color_on": "#E25563",
      "color_off": "#3A4250",
      "blink": true,
      "label": "超温"
    },
    {
      "id": "TXT_StatusLabel",
      "type": "Text",
      "x": 30,
      "y": 340,
      "width": 80,
      "height": 40,
      "text": "系统状态",
      "font_size": 16,
      "bold": false,
      "color": "#E6EDF3"
    },
    {
      "id": "SIO_Status",
      "type": "SymbolicIOField",
      "x": 120,
      "y": 340,
      "width": 120,
      "height": 40,
      "mode": "Output",
      "process_tag": "System_Status",
      "font_size": 16,
      "label": "",
      "text_list": "System_Status_List"
    },
    {
      "id": "BTN_ResetAlarm",
      "type": "Button",
      "x": 400,
      "y": 340,
      "width": 120,
      "height": 50,
      "text": "复位报警",
      "press_script": "Sub_ResetAlarm",
      "release_script": null,
      "click_script": null,
      "background_color": "#3A4250"
    }
  ],
  "scripts": [
    {
      "name": "Sub_ResetAlarm",
      "language": "VBS",
      "purpose": "复位所有报警：置位复位变量",
      "code": "' 按下复位报警按钮，发出复位命令\nSmartTags(\"Alarm_Reset\") = 1\n' 延时或脉冲由PLC处理，此处只写一次"
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 800,
    "height": 480
  }
}