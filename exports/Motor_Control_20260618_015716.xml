  <VBScripts>
    <Script Name="Sub_Start" Language="VBS">
      <Purpose>按下启动按钮：置位启动命令，复位停止命令</Purpose>
      <Code>
        ' 启动按钮：发出启动命令\nSmartTags("Motor_Start") = 1\nSmartTags("Motor_Stop") = 0
      </Code>
    </Script>
    <Script Name="Sub_Stop" Language="VBS">
      <Purpose>按下停止按钮：置位停止命令，复位启动命令</Purpose>
      <Code>
        ' 停止按钮：发出停止命令\nSmartTags("Motor_Stop") = 1\nSmartTags("Motor_Start") = 0
      </Code>
    </Script>
    <Script Name="Sub_Reset" Language="VBS">
      <Purpose>按下复位按钮：复位故障</Purpose>
      <Code>
        ' 复位按钮：清除故障\nSmartTags("Motor_Reset") = 1
      </Code>
    </Script>
  </VBScripts>
