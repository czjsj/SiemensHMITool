  <VBScripts>
    <Script Name="Sub_Start" Language="VBS">
      <Purpose>启动按钮按下时置位启动命令，复位停止命令</Purpose>
      <Code>
        ' 启动按钮
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      </Code>
    </Script>
    <Script Name="Sub_Stop" Language="VBS">
      <Purpose>停止按钮按下时置位停止命令，复位启动命令</Purpose>
      <Code>
        ' 停止按钮
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      </Code>
    </Script>
    <Script Name="Sub_Reset" Language="VBS">
      <Purpose>复位按钮按下时置位复位命令</Purpose>
      <Code>
        ' 复位按钮
SmartTags("Motor_Reset") = 1
      </Code>
    </Script>
  </VBScripts>
