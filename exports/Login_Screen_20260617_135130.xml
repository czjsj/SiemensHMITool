  <VBScripts>
    <Script Name="Sub_Login" Language="VBScript">
      <Purpose>校验用户名密码，若正确则置位登录状态，否则提示错误。</Purpose>
      <Code>' 登录脚本：校验用户名密码（预设admin / 123456）
Dim sUser, sPass
sUser = SmartTags(&quot;Login_Username&quot;)
sPass = SmartTags(&quot;Login_Password&quot;)
If sUser = &quot;admin&quot; And sPass = &quot;123456&quot; Then
    SmartTags(&quot;Login_Active&quot;) = 1
    MsgBox &quot;登录成功！&quot;, vbInformation, &quot;登录&quot;
Else
    SmartTags(&quot;Login_Active&quot;) = 0
    MsgBox &quot;用户名或密码错误！&quot;, vbCritical, &quot;登录失败&quot;
End If</Code>
    </Script>
    <Script Name="Sub_Logout" Language="VBScript">
      <Purpose>退出登录，清除登录状态并提示。</Purpose>
      <Code>' 退出脚本：清除登录状态
SmartTags(&quot;Login_Active&quot;) = 0
MsgBox &quot;已退出登录。&quot;, vbInformation, &quot;退出&quot;</Code>
    </Script>
  </VBScripts>
