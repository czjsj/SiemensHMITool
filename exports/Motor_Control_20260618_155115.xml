  <VBScripts>
    
      <Purpose>启动按钮按下：置位启动，复位停止</Purpose>
      
        ' 启动命令
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>停止按钮按下：置位停止，复位启动</Purpose>
      
        ' 停止命令
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>复位按钮按下：发出复位脉冲</Purpose>
      
        ' 复位命令（脉冲）
SmartTags("Motor_Reset") = 1
      
    
  </VBScripts>
