  <VBScripts>
    
      <Purpose>校验用户名密码，硬编码admin/123456，正确则置位在线状态，否则提示</Purpose>
      
        ' 登录校验
Dim sUser, sPwd
sUser = SmartTags("Login_Username")
sPwd = SmartTags("Login_Password")
If sUser = "admin" And sPwd = "123456" Then
    SmartTags("Login_Online") = 1
Else
    MsgBox "用户名或密码错误！", vbExclamation, "登录失败"
    SmartTags("Login_Online") = 0
End If
      
    
    
      <Purpose>退出登录，清除在线状态</Purpose>
      
        ' 退出登录
SmartTags("Login_Online") = 0
      
    
    
      <Purpose>按钮「登录」— 按下置位 Login_BtnLogin</Purpose>
      
        ' 按钮「登录」按下 — 按下置位
SmartTags("Login_BtnLogin") = 1

      
    
    
      <Purpose>按钮「登录」— 释放复位 Login_BtnLogin</Purpose>
      
        ' 按钮「登录」释放 — 释放复位
SmartTags("Login_BtnLogin") = 0

      
    
    
      <Purpose>按钮「退出」— 按下置位 Login_BtnLogout</Purpose>
      
        ' 按钮「退出」按下 — 按下置位
SmartTags("Login_BtnLogout") = 1

      
    
    
      <Purpose>按钮「退出」— 释放复位 Login_BtnLogout</Purpose>
      
        ' 按钮「退出」释放 — 释放复位
SmartTags("Login_BtnLogout") = 0

      
    
  </VBScripts>
