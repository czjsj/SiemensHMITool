  <VBScripts>
    <Script Name="Sub_Login" Language="VBScript">
      <Purpose>校验用户名/密码（固定 admin/123456），成功则置位 Login_Status，失败弹出提示</Purpose>
      <Code>' 登录校验：固定账号 admin / 123456
Dim sUser, sPass
sUser = SmartTags(&quot;Login_UserName&quot;)
sPass = SmartTags(&quot;Login_Password&quot;)
If sUser = &quot;admin&quot; And sPass = &quot;123456&quot; Then
    SmartTags(&quot;Login_Status&quot;) = True
    HMIRuntime.Trace &quot;登录成功&quot;
Else
    SmartTags(&quot;Login_Status&quot;) = False
    MsgBox &quot;用户名或密码错误！&quot;, vbExclamation, &quot;登录失败&quot;
End If</Code>
    </Script>
    <Script Name="Sub_Logout" Language="VBScript">
      <Purpose>退出登录：清除登录状态与用户输入</Purpose>
      <Code>' 退出登录：清除状态与输入
SmartTags(&quot;Login_Status&quot;) = False
SmartTags(&quot;Login_UserName&quot;) = &quot;&quot;
SmartTags(&quot;Login_Password&quot;) = &quot;&quot;
HMIRuntime.Trace &quot;用户已退出&quot;</Code>
    </Script>
  </VBScripts>
</Document>
