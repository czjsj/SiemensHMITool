  <VBScripts>
    
      <Purpose>按下启动按钮：置位启动命令变量（PLC逻辑处理保持）</Purpose>
      
        ' 启动按钮瞬时置位
SmartTags("BTN_Motor_Start") = 1
      
    
    
      <Purpose>按下停止按钮：置位停止命令变量</Purpose>
      
        ' 停止按钮瞬时置位
SmartTags("BTN_Motor_Stop") = 1
      
    
    
      <Purpose>按下复位按钮：置位复位命令变量</Purpose>
      
        ' 复位按钮瞬时置位
SmartTags("BTN_Motor_Reset") = 1
      
    
    
      <Purpose>按钮「启动」— 按下置位 BTN_Motor_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("BTN_Motor_Start") = 1

      
    
    
      <Purpose>按钮「启动」— 释放复位 BTN_Motor_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("BTN_Motor_Start") = 0

      
    
    
      <Purpose>按钮「停止」— 按下置位 BTN_Motor_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("BTN_Motor_Stop") = 1

      
    
    
      <Purpose>按钮「停止」— 释放复位 BTN_Motor_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("BTN_Motor_Stop") = 0

      
    
    
      <Purpose>按钮「复位」— 按下置位 BTN_Motor_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("BTN_Motor_Reset") = 1

      
    
    
      <Purpose>按钮「复位」— 释放复位 BTN_Motor_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("BTN_Motor_Reset") = 0

      
    
  </VBScripts>
</Document>