{
  "meta": {
    "screen_name": "Motor_Control_800",
    "title": "电机控制画面",
    "description": "基于800x480分辨率的电机启停控制画面：启动/停止/复位按钮，运行与故障指示灯，转速与运行模式显示。所有变量遵循前缀规范，布局紧凑整齐。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "BTN_Motor_Start",
      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动命令（瞬时）"
    },
    {
      "name": "BTN_Motor_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止命令（瞬时）"
    },
    {
      "name": "BTN_Motor_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "复位命令（瞬时）"
    },
    {
      "name": "STS_Motor_Run",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行状态反馈"
    },
    {
      "name": "LMP_Motor_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障状态（闪烁）"
    },
    {
      "name": "IO_Motor_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "电机转速 rpm"
    },
    {
      "name": "SIO_Motor_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式 0停止/1手动/2自动"
    }
  ],
  "text_lists": [
    {
      "name": "Motor_Mode_List",
      "entries": [
