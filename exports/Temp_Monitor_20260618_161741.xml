    <AttributeList>
      <Name>Temp_Monitor</Name>
      <DisplayName>温度监控画面</DisplayName>
      <Width>800</Width>
      <Height>480</Height>
    </AttributeList>
    <Tags>
      <Tag Name="Temperature_1" DataType="Real">
        <Address>%MD100</Address>
        <Comment>测点1温度</Comment>
      </Tag>
      <Tag Name="Temperature_2" DataType="Real">
        <Address>%MD104</Address>
        <Comment>测点2温度</Comment>
      </Tag>
      <Tag Name="Temperature_3" DataType="Real">
        <Address>%MD108</Address>
        <Comment>测点3温度</Comment>
      </Tag>
      <Tag Name="Alarm_1" DataType="Bool">
        <Address>%M1.0</Address>
        <Comment>测点1超温报警</Comment>
      </Tag>
      <Tag Name="Alarm_2" DataType="Bool">
        <Address>%M1.1</Address>
        <Comment>测点2超温报警</Comment>
      </Tag>
      <Tag Name="Alarm_3" DataType="Bool">
        <Address>%M1.2</Address>
        <Comment>测点3超温报警</Comment>
      </Tag>
      <Tag Name="Alarm_Reset" DataType="Bool">
        <Address>%M1.3</Address>
        <Comment>复位所有报警</Comment>
      </Tag>
      <Tag Name="System_Status" DataType="Int">
        <Address>%MW30</Address>
        <Comment>系统状态：0正常/1警告/2故障</Comment>
      </Tag>
    </Tags>
    <TextLists>
      <TextList Name="System_Status_List">
        <Entry Value="0" Text="正常" />
        <Entry Value="1" Text="警告" />
        <Entry Value="2" Text="故障" />
