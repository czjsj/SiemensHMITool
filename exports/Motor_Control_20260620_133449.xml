  <Engineering version="V16" />
  <Screen ID="b7fc4ee3-1271-4499-95d6-6465cef4a9f0" Name="Motor_Control">
    <AttributeList>
      <Name>Motor_Control</Name>
      <DisplayName>电机控制画面</DisplayName>
      <Width>800</Width>
      <Height>480</Height>
    </AttributeList>
    <Tags>
      <Tag Name="BTN_Start" DataType="Bool">
        <Address>%M0.0</Address>
        <Comment>启动按钮脉冲</Comment>
      </Tag>
      <Tag Name="BTN_Stop" DataType="Bool">
        <Address>%M0.1</Address>
        <Comment>停止按钮脉冲</Comment>
      </Tag>
      <Tag Name="BTN_Reset" DataType="Bool">
        <Address>%M0.2</Address>
        <Comment>复位按钮脉冲</Comment>
      </Tag>
      <Tag Name="STS_Run" DataType="Bool">
        <Address>%M0.3</Address>
        <Comment>运行状态反馈</Comment>
      </Tag>
      <Tag Name="LMP_Fault" DataType="Bool">
        <Address>%M0.4</Address>
        <Comment>故障标志（闪烁）</Comment>
      </Tag>
      <Tag Name="IO_Speed" DataType="Real">
        <Address>%MD10</Address>
        <Comment>电机当前转速，单位rpm</Comment>
      </Tag>
      <Tag Name="SIO_Mode" DataType="Int">
        <Address>%MW20</Address>
        <Comment>运行模式: 0停止/1手动/2自动</Comment>
      </Tag>
    </Tags>
    <TextLists>
      <TextList Name="Motor_Mode_List">
        <Entry Value="0" Text="停止" />
        <Entry Value="1" Text="手动" />
        <Entry Value="2" Text="自动" />
      </TextList>
    </TextLists>
