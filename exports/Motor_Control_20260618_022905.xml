  <VBScripts>
    
      <Purpose>启动按钮按下时发出启动命令，同时复位停止命令</Purpose>
      
        ' 启动按钮按下
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>停止按钮按下时发出停止命令，同时复位启动命令</Purpose>
      
        ' 停止按钮按下
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>复位按钮按下时将复位标志位置1（由PLC逻辑复位故障）</Purpose>
      
        ' 复位按钮按下
SmartTags("Motor_Reset") = 1
      
    
  </VBScripts>
