  <VBScripts>
    
      <Purpose>校验用户名和密码，成功则置位登录状态并提示，失败则提示错误</Purpose>
      
        ' 登录校验：用户名 admin，密码 123456
Dim sUser, sPass
sUser = SmartTags("User_Name")
sPass = SmartTags("User_Password")
If sUser = "admin" And sPass = "123456" Then
    SmartTags("Login_Status") = True
    HMIRuntime.Trace "登录成功"
    ShowSystemAlarm "登录成功！"
Else
    SmartTags("Login_Status") = False
    ShowSystemAlarm "用户名或密码错误！"
End If
      
    
    
      <Purpose>退出登录，清除登录状态并提示</Purpose>
      
        ' 退出登录
SmartTags("Login_Status") = False
SmartTags("User_Name") = ""
SmartTags("User_Password") = ""
ShowSystemAlarm "已退出登录！"
      
    
  </VBScripts>
