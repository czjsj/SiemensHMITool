{
  "meta": {
    "screen_name": "Pipeline_Flow",
    "title": "管道流量控制",
    "description": "管道流量画面：显示瞬时/累计流量，泵运行指示灯，启动/停止按钮，流动态指示灯及动画数值。假设累计流量为Real，泵运行状态由PLC反馈。流动动画通过VBS循环步进0~100。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Flow_Instant",
      "data_type": "Real",
      "address": "%MD100",
      "comment": "瞬时流量 m³/h"
    },
    {
      "name": "Flow_Total",
      "data_type": "Real",
      "address": "%MD104",
      "comment": "累计流量 m³"
    },
    {
      "name": "Pump_Running",
      "data_type": "Bool",
      "address": "%M1.0",
      "comment": "泵运行反馈"
    },
    {
      "name": "Flow_Animation",
      "data_type": "Int",
      "address": "%MW30",
      "comment": "流动动画值 0~100"
    },
    {
      "name": "Flow_AnimActive",
      "data_type": "Bool",
      "address": "%M1.1",
      "comment": "流动动画激活标志"
    }
  ],
  "text_lists": [],
  "objects": [
    {
