    {
      "id": "BTN_Start",
      "type": "Button",
      "x": 420,
      "y": 95,
      "width": 130,
      "height": 56,
      "text": "启动",
      "press_script": "Sub_StartFlow",
      "release_script": null,
      "click_script": null,
      "background_color": "#27D17F"
    },
    {
      "id": "BTN_Stop",
      "type": "Button",
      "x": 580,
      "y": 95,
      "width": 130,
      "height": 56,
      "text": "停止",
      "press_script": "Sub_StopFlow",
      "release_script": null,
      "click_script": null,
      "background_color": "#E25563"
    }
  ],
  "scripts": [
    {
      "name": "Sub_StartFlow",
      "language": "VBS",
      "purpose": "启动泵和流动动画模拟：泵运行置1，激活流动标志，循环步进画面动画值0~100共10秒后自动停止",
      "code": "' 启动及流动模拟\nDim i\nSmartTags(\"Pump_Running\") = 1\nSmartTags(\"Flow_AnimActive\") = 1\nFor i = 1 To 40\n    SmartTags(\"Flow_Animation\") = (SmartTags(\"Flow_Animation\") + 5) Mod 101\n    HMIRuntime.Sleep 250\nNext\nSmartTags(\"Flow_AnimActive\") = 0\nSmartTags(\"Flow_Animation\") = 0\nSmartTags(\"Pump_Running\") = 0"
    },
    {
      "name": "Sub_StopFlow",
      "language": "VBS",
      "purpose": "立即停止泵和流动动画",
      "code": "' 停止泵和动画\nSmartTags(\"Pump_Running\") = 0\nSmartTags(\"Flow_AnimActive\") = 0\nSmartTags(\"Flow_Animation\") = 0"
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 800,
    "height": 480
  }
}