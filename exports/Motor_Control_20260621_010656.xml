  <VBScripts>
    
      <Purpose>启动按钮按下：置位启动命令，同时复位停止命令</Purpose>
      
        ' Sub_Start: 按下启动按钮时执行
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>停止按钮按下：置位停止命令，同时复位启动命令</Purpose>
      
        ' Sub_Stop: 按下停止按钮时执行
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>复位按钮按下：置位复位命令</Purpose>
      
        ' Sub_Reset: 按下复位按钮时执行
SmartTags("Motor_Reset") = 1
      
    
    
      <Purpose>按钮「启动」— 按下置位 Motor_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("Motor_Start") = 1

      
    
    
      <Purpose>按钮「启动」— 释放复位 Motor_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("Motor_Start") = 0

      
    
    
      <Purpose>按钮「停止」— 按下置位 Motor_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("Motor_Stop") = 1

      
    
    
      <Purpose>按钮「停止」— 释放复位 Motor_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("Motor_Stop") = 0

      
    
    
      <Purpose>按钮「复位」— 按下置位 Motor_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("Motor_Reset") = 1

      
    
    
      <Purpose>按钮「复位」— 释放复位 Motor_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("Motor_Reset") = 0

      
    
  </VBScripts>
