        <Comment>启动命令</Comment>
      </Tag>
      <Tag Name="Motor_Stop" DataType="Bool">
        <Address>%M0.1</Address>
        <Comment>停止命令</Comment>
      </Tag>
      <Tag Name="Motor_Reset" DataType="Bool">
