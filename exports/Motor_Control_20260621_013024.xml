  <Engineering version="V16" />
  <Screen ID="f108f633-faa6-438b-b42d-58bcac73dfc9" Name="Motor_Control">
    <AttributeList>
      <Name>Motor_Control</Name>
      <DisplayName>电机控制画面</DisplayName>
      <Width>800</Width>
      <Height>480</Height>
    </AttributeList>
    <Tags>
      <Tag Name="Motor_Start" DataType="Bool">
        <Comment>启动命令</Comment>
      </Tag>
      <Tag Name="Motor_Stop" DataType="Bool">
        <Comment>停止命令</Comment>
      </Tag>
      <Tag Name="Motor_Reset" DataType="Bool">
        <Comment>复位命令</Comment>
      </Tag>
      <Tag Name="Motor_Running" DataType="Bool">
        <Comment>运行状态</Comment>
      </Tag>
      <Tag Name="Motor_Fault" DataType="Bool">
        <Comment>故障状态</Comment>
      </Tag>
      <Tag Name="Motor_Speed" DataType="Real">
        <Comment>转速 (rpm)</Comment>
      </Tag>
      <Tag Name="Motor_Mode" DataType="Int">
        <Comment>运行模式 (0=停止,1=手动,2=自动)</Comment>
      </Tag>
    </Tags>
    <TextLists>
      <TextList Name="Motor_Mode_List">
        <Entry Value="0" Text="停止" />
        <Entry Value="1" Text="手动" />
        <Entry Value="2" Text="自动" />
      </TextList>
    </TextLists>
