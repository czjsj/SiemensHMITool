  <VBScripts>
    
      <Purpose>校验用户名密码，匹配则置位在线状态并提示成功，否则提示错误</Purpose>
      
        ' 登录校验
Dim sUser, sPass
sUser = SmartTags("User_Name")
sPass = SmartTags("User_Password")
' 硬编码校验 admin / 123456
If sUser = "admin" And sPass = "123456" Then
    SmartTags("LoginActive") = True
    HMIRuntime.OutputSystemAlarm "登录成功", 1
Else
    SmartTags("LoginActive") = False
    HMIRuntime.OutputSystemAlarm "用户名或密码错误", 1
End If
      
    
    
      <Purpose>退出登录：清除在线状态并提示</Purpose>
      
        ' 退出登录
SmartTags("LoginActive") = False
HMIRuntime.OutputSystemAlarm "已退出", 1
      
    
  </VBScripts>
