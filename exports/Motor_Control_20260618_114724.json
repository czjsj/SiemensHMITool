{
  "meta": {
    "screen_name": "Motor_Control",
    "title": "电机控制画面",
    "description": "电机启停控制：启动/停止/复位按钮，运行与故障指示灯，转速与运行模式显示。假设转速为Real型，模式为Int(0=停止/1=手动/2=自动)。分辨率1280x800。",
    "resolution": "1280x800",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Motor_Start",
      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动命令"
    },
    {
      "name": "Motor_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止命令"
    },
    {
      "name": "Motor_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "故障复位"
    },
    {
      "name": "Motor_Running",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行反馈"
    },
    {
      "name": "Motor_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障标志"
    },
    {
      "name": "Motor_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "转速rpm"
    },
    {
      "name": "Motor_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式"
    }
  ],
  "text_lists": [
    {
      "name": "Motor_Mode_List",
      "entries": [
        {
          "value": 0,
          "text": "停止"
        },
        {
          "value": 1,
          "text": "手动"
        },
        {
          "value": 2,
          "text": "自动"
        }
      ]
    }
  ],
