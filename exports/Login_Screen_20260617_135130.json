  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名密码，若正确则置位登录状态，否则提示错误。",
      "code": "' 登录脚本：校验用户名密码（预设admin / 123456）\nDim sUser, sPass\nsUser = SmartTags(\"Login_Username\")\nsPass = SmartTags(\"Login_Password\")\nIf sUser = \"admin\" And sPass = \"123456\" Then\n    SmartTags(\"Login_Active\") = 1\n    MsgBox \"登录成功！\", vbInformation, \"登录\"\nElse\n    SmartTags(\"Login_Active\") = 0\n    MsgBox \"用户名或密码错误！\", vbCritical, \"登录失败\"\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录，清除登录状态并提示。",
      "code": "' 退出脚本：清除登录状态\nSmartTags(\"Login_Active\") = 0\nMsgBox \"已退出登录。\", vbInformation, \"退出\""
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
}