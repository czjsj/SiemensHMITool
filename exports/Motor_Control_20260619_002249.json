{
  "meta": {
    "screen_name": "Motor_Control",
    "title": "电机控制画面",
    "description": "电机启停控制：启动/停止/复位按钮，运行与故障指示灯，转速与运行模式显示。基于800x480分辨率布局。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "BTN_Start",
      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动按钮变量"
    },
    {
      "name": "BTN_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止按钮变量"
    },
    {
      "name": "BTN_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "复位按钮变量"
    },
    {
      "name": "STS_Run",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行状态"
    },
    {
      "name": "LMP_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障标志"
    },
    {
      "name": "IO_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "转速 rpm"
    },
    {
      "name": "SIO_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式 0停止 1手动 2自动"
    }
  ],
  "text_lists": [
    {
      "name": "Motor_Mode_List",
      "entries": [
        {
          "value": 0,
          "text": "停止"
        },
        {
          "value": 1,
          "text": "手动"
        },
        {
          "value": 2,
          "text": "自动"
        }
      ]
    }
  ],
  "objects": [
