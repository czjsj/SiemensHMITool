      "x": 300,
      "y": 20,
      "width": 200,
      "height": 36,
      "text": "电机控制",
      "font_size": 24,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "BTN_Start",
      "type": "Button",
      "x": 215,
      "y": 80,
      "width": 110,
      "height": 50,
      "text": "启动",
      "tag_mode": "momentary",
      "process_tag": "BTN_Start",
      "press_script": "Sub_BTN_Start_Press",
      "release_script": "Sub_BTN_Start_Release",
      "click_script": null,
      "background_color": "#27D17F"
    },
    {
      "id": "BTN_Stop",
      "type": "Button",
      "x": 349,
      "y": 80,
      "width": 110,
      "height": 50,
      "text": "停止",
      "tag_mode": "momentary",
      "process_tag": "BTN_Stop",
      "press_script": "Sub_BTN_Stop_Press",
      "release_script": "Sub_BTN_Stop_Release",
      "click_script": null,
      "background_color": "#E25563"
    },
    {
      "id": "BTN_Reset",
      "type": "Button",
      "x": 483,
      "y": 80,
      "width": 110,
      "height": 50,
      "text": "复位",
      "tag_mode": "momentary",
