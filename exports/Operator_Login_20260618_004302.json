  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名密码：admin/123456，成功置位在线标志并提示，失败提示",
      "code": "' 登录按钮：校验用户名密码\nDim sUser, sPass\nsUser = SmartTags(\"Login_UserName\")\nsPass = SmartTags(\"Login_Password\")\nIf sUser = \"admin\" And sPass = \"123456\" Then\n    SmartTags(\"Login_Status\") = 1\n    HMIRuntime.Trace \"登录成功\"\n    ShowSystemAlarm \"登录成功\"\nElse\n    SmartTags(\"Login_Status\") = 0\n    ShowSystemAlarm \"用户名或密码错误\"\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录：清除在线状态并提示",
      "code": "' 退出按钮：清除在线标志\nSmartTags(\"Login_Status\") = 0\nShowSystemAlarm \"已退出登录\""
    }
  ],
