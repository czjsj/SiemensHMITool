  <VBScripts>
    <Script Name="Sub_Start" Language="VBS">
      <Purpose>按下启动按钮：置位启动命令，复位停止命令</Purpose>
      <Code>
        ' 启动按钮：发出启动命令
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      </Code>
    </Script>
    <Script Name="Sub_Stop" Language="VBS">
      <Purpose>按下停止按钮：置位停止命令，复位启动命令</Purpose>
      <Code>
        ' 停止按钮：发出停止命令
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      </Code>
    </Script>
    <Script Name="Sub_Reset" Language="VBS">
      <Purpose>按下复位按钮：置位复位命令（脉冲型，建议使用上升沿）</Purpose>
      <Code>
        ' 复位按钮：发出复位脉冲（需PLC边沿处理或保持一段时间）
SmartTags("Motor_Reset") = 1
' 注意：如果复位信号需要脉冲，可以考虑延时复位，或由PLC处理
' 此处仅置位，用户可根据实际需求调整
      </Code>
    </Script>
  </VBScripts>
