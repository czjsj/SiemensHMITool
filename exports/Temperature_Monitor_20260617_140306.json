{
  "meta": {
    "screen_name": "Temperature_Monitor",
    "title": "温度监控画面",
    "description": "显示三个测点温度，每个测点配超温报警指示灯（红色闪烁）和复位按钮，底部显示系统状态（正常/警告/故障）。",
    "resolution": "1280x800",
    "hmi_type": "Comfort"
  },
  "tags": [
    {
      "name": "Temp_Value_1",
      "data_type": "Real",
      "address": "%MD100",
      "comment": "测点1温度"
    },
    {
      "name": "Temp_Value_2",
      "data_type": "Real",
      "address": "%MD104",
      "comment": "测点2温度"
    },
    {
      "name": "Temp_Value_3",
      "data_type": "Real",
      "address": "%MD108",
      "comment": "测点3温度"
    },
    {
      "name": "Alarm_Overheat_1",
      "data_type": "Bool",
      "address": "%M1.0",
      "comment": "测点1超温报警"
    },
    {
      "name": "Alarm_Overheat_2",
      "data_type": "Bool",
      "address": "%M1.1",
      "comment": "测点2超温报警"
    },
    {
      "name": "Alarm_Overheat_3",
      "data_type": "Bool",
      "address": "%M1.2",
      "comment": "测点3超温报警"
    },
    {
      "name": "Alarm_Reset_1",
      "data_type": "Bool",
      "address": "%M2.0",
      "comment": "测点1报警复位"
    },
    {
      "name": "Alarm_Reset_2",
      "data_type": "Bool",
      "address": "%M2.1",
      "comment": "测点2报警复位"
    },
    {
      "name": "Alarm_Reset_3",
      "data_type": "Bool",
      "address": "%M2.2",
      "comment": "测点3报警复位"
    },
    {
      "name": "System_Status",
      "data_type": "Int",
      "address": "%MW30",
      "comment": "系统状态 0正常/1警告/2故障"
    }
  ],
  "text_lists": [
    {
      "name": "System_Status_List",
      "entries": [
        {
          "value": 0,
          "text": "正常"
        },
        {
          "value": 1,
          "text": "警告"
        },
        {
          "value": 2,
          "text": "故障"
        }
      ]
    }
  ],
  "objects": [
    {
      "id": "TXT_Title",
      "type": "Text",
      "x": 480,
      "y": 30,
      "width": 320,
      "height": 44,
      "text": "温度监控画面",
      "font_size": 26,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "TXT_Point1",
      "type": "Text",
      "x": 100,
      "y": 130,
      "width": 120,
      "height": 36,
      "text": "测点1温度",
      "font_size": 18,
      "bold": false,
      "color": "#E6EDF3"
    },
    {
      "id": "IO_Temp_1",
      "type": "IOField",
      "x": 240,
      "y": 128,
      "width": 140,
