  "scripts": [
    {
      "name": "Sub_Reset_1",
      "language": "VBS",
      "purpose": "复位测点1超温报警",
      "code": "' 复位测点1报警\nSmartTags(\"Alarm_Reset_1\") = 1"
    },
    {
      "name": "Sub_Reset_2",
      "language": "VBS",
      "purpose": "复位测点2超温报警",
