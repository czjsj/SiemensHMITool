  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名密码，预设 admin / 123456，正确则置位在线状态并提示，否则提示错误",
      "code": "' 登录校验脚本\n' 读取输入的用户名和密码\nDim sUser, sPwd\nsUser = HMIRuntime.Tags(\"Login_User\").Read\nsPwd  = HMIRuntime.Tags(\"Login_Password\").Read\n\n' 预设账号密码（实际项目应从用户管理读取）\nConst ADMIN_USER = \"admin\"\nConst ADMIN_PWD  = \"123456\"\n\nIf sUser = ADMIN_USER And sPwd = ADMIN_PWD Then\n    HMIRuntime.Tags(\"Login_Online\").Write 1\n    HMIRuntime.System.ShowSystemAlarm \"登录成功\"\nElse\n    HMIRuntime.Tags(\"Login_Online\").Write 0\n    HMIRuntime.System.ShowSystemAlarm \"用户名或密码错误\"\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录：清除在线状态及输入域",
      "code": "' 退出登录脚本\nHMIRuntime.Tags(\"Login_Online\").Write 0\nHMIRuntime.Tags(\"Login_User\").Write \"\"\nHMIRuntime.Tags(\"Login_Password\").Write \"\"\nHMIRuntime.System.ShowSystemAlarm \"已退出登录\""
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
