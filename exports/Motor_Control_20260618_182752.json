  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "按下启动按钮：置位启动命令，复位停止命令",
      "code": "' 启动按钮\nSmartTags(\"Motor_Start\") = 1\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "按下停止按钮：置位停止命令，复位启动命令",
      "code": "' 停止按钮\nSmartTags(\"Motor_Stop\") = 1\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "按下复位按钮：发出复位脉冲",
      "code": "' 复位按钮\nSmartTags(\"Motor_Reset\") = 1"
    }
  ],
