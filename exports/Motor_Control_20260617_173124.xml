    </ObjectList>
  </Screen>
  <VBScripts>
    <Script Name="Sub_Start" Language="VBS">
      <Purpose>按下启动按钮：置位启动命令，清除停止命令</Purpose>
      <Code>
        ' Sub_Start - 电机启动
SmartTags("Motor_Start") = 1
SmartTags("Motor_Stop") = 0
      </Code>
    </Script>
    <Script Name="Sub_Stop" Language="VBS">
      <Purpose>按下停止按钮：置位停止命令，清除启动命令</Purpose>
      <Code>
        ' Sub_Stop - 电机停止
SmartTags("Motor_Stop") = 1
SmartTags("Motor_Start") = 0
      </Code>
    </Script>
    <Script Name="Sub_Reset" Language="VBS">
      <Purpose>按下复位按钮：复位故障标志</Purpose>
      <Code>
        ' Sub_Reset - 故障复位
SmartTags("Motor_Reset") = 1
      </Code>
    </Script>
  </VBScripts>
</Document>