  <VBScripts>
    <Script Name="Sub_Login" Language="VBS">
      <Purpose>校验用户名密码：admin/123456，成功置位在线标志并提示，失败提示</Purpose>
      <Code>
        ' 登录按钮：校验用户名密码
Dim sUser, sPass
sUser = SmartTags("Login_UserName")
sPass = SmartTags("Login_Password")
If sUser = "admin" And sPass = "123456" Then
    SmartTags("Login_Status") = 1
    HMIRuntime.Trace "登录成功"
    ShowSystemAlarm "登录成功"
Else
    SmartTags("Login_Status") = 0
    ShowSystemAlarm "用户名或密码错误"
End If
      </Code>
    </Script>
    <Script Name="Sub_Logout" Language="VBS">
      <Purpose>退出登录：清除在线状态并提示</Purpose>
      <Code>
        ' 退出按钮：清除在线标志
SmartTags("Login_Status") = 0
ShowSystemAlarm "已退出登录"
      </Code>
    </Script>
  </VBScripts>
