  "scripts": [
    {
      "name": "Sub_BTN_UpCall_Press",
      "language": "VBS",
      "purpose": "按钮「上行呼叫」— 按下置位 BTN_Elevator_Up",
      "code": "' 按钮「上行呼叫」按下 — 按下置位\nSmartTags(\"BTN_Elevator_Up\") = 1"
    },
    {
      "name": "Sub_BTN_UpCall_Release",
      "language": "VBS",
      "purpose": "按钮「上行呼叫」— 释放复位 BTN_Elevator_Up",
      "code": "' 按钮「上行呼叫」释放 — 释放复位\nSmartTags(\"BTN_Elevator_Up\") = 0"
    },
    {
      "name": "Sub_BTN_DownCall_Press",
      "language": "VBS",
      "purpose": "按钮「下行呼叫」— 按下置位 BTN_Elevator_Down",
      "code": "' 按钮「下行呼叫」按下 — 按下置位\nSmartTags(\"BTN_Elevator_Down\") = 1"
    },
    {
      "name": "Sub_BTN_DownCall_Release",
      "language": "VBS",
      "purpose": "按钮「下行呼叫」— 释放复位 BTN_Elevator_Down",
      "code": "' 按钮「下行呼叫」释放 — 释放复位\nSmartTags(\"BTN_Elevator_Down\") = 0"
    },
    {
      "name": "Sub_BTN_EmergencyStop_Toggle",
      "language": "VBS",
      "purpose": "切换按钮「急停」— 翻转变量 MEM_Elevator_EmergencyStop",
      "code": "' 切换按钮「急停」— 翻转变量 MEM_Elevator_EmergencyStop\nSmartTags(\"MEM_Elevator_EmergencyStop\") = Not SmartTags(\"MEM_Elevator_EmergencyStop\")"
    }
  ],
