  <VBScripts>
    
      <Purpose>启动按钮按下：除绑定变量自动置位外，可在此添加额外逻辑</Purpose>
      
        ' 启动按钮按下，系统自动置位 Motor_Start（momentary模式）
' 如需额外操作，在此添加
      
    
    
      <Purpose>停止按钮按下：除绑定变量自动置位外，可在此添加额外逻辑</Purpose>
      
        ' 停止按钮按下，系统自动置位 Motor_Stop（momentary模式）
' 如需额外操作，在此添加
      
    
    
      <Purpose>复位按钮按下：除绑定变量自动置位外，可在此添加额外逻辑</Purpose>
      
        ' 复位按钮按下，系统自动置位 Motor_Reset（momentary模式）
' 如需额外操作，在此添加
      
    
    
      <Purpose>按钮「启动」— 按下置位 Motor_Start</Purpose>
      
        ' 按钮「启动」按下 — 按下置位
SmartTags("Motor_Start") = 1
      
    
    
      <Purpose>按钮「启动」— 释放复位 Motor_Start</Purpose>
      
        ' 按钮「启动」释放 — 释放复位
SmartTags("Motor_Start") = 0
      
    
    
      <Purpose>按钮「停止」— 按下置位 Motor_Stop</Purpose>
      
        ' 按钮「停止」按下 — 按下置位
SmartTags("Motor_Stop") = 1
      
    
    
      <Purpose>按钮「停止」— 释放复位 Motor_Stop</Purpose>
      
        ' 按钮「停止」释放 — 释放复位
SmartTags("Motor_Stop") = 0
      
    
    
      <Purpose>按钮「复位」— 按下置位 Motor_Reset</Purpose>
      
        ' 按钮「复位」按下 — 按下置位
SmartTags("Motor_Reset") = 1
      
    
    
      <Purpose>按钮「复位」— 释放复位 Motor_Reset</Purpose>
      
        ' 按钮「复位」释放 — 释放复位
SmartTags("Motor_Reset") = 0
      
    
  </VBScripts>
