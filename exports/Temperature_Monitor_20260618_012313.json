      "address": "%M10.2",
      "comment": "测点3超温报警"
    },
    {
      "name": "Reset_Alarm1",
      "data_type": "Bool",
      "address": "%M11.0",
      "comment": "复位测点1报警"
    },
    {
      "name": "Reset_Alarm2",
      "data_type": "Bool",
      "address": "%M11.1",
      "comment": "复位测点2报警"
    },
    {
      "name": "Reset_Alarm3",
      "data_type": "Bool",
      "address": "%M11.2",
      "comment": "复位测点3报警"
    },
    {
      "name": "Sys_Status",
      "data_type": "Int",
      "address": "%MW30",
      "comment": "系统状态:0正常1警告2故障"
    }
  ],
  "text_lists": [
    {
      "name": "Sys_Status_List",
      "entries": [
        {
          "value": 0,
          "text": "正常"
        },
        {
          "value": 1,
          "text": "警告"
        },
        {
          "value": 2,
          "text": "故障"
        }
      ]
