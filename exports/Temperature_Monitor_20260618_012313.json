  "scripts": [
    {
      "name": "Sub_Reset1_Press",
      "language": "VBS",
      "purpose": "按下复位1按钮，置位复位变量",
      "code": "' 复位测点1报警\nSmartTags(\"Reset_Alarm1\") = 1"
    },
    {
      "name": "Sub_Reset1_Release",
      "language": "VBS",
      "purpose": "释放复位1按钮，清零复位变量",
      "code": "' 复位测点1报警释放\nSmartTags(\"Reset_Alarm1\") = 0"
    },
    {
      "name": "Sub_Reset2_Press",
      "language": "VBS",
      "purpose": "按下复位2按钮，置位复位变量",
      "code": "SmartTags(\"Reset_Alarm2\") = 1"
    },
    {
      "name": "Sub_Reset2_Release",
      "language": "VBS",
      "purpose": "释放复位2按钮，清零复位变量",
      "code": "SmartTags(\"Reset_Alarm2\") = 0"
    },
    {
