{
  "meta": {
    "screen_name": "Temperature_Monitor",
    "title": "温度监控画面",
    "description": "显示三个测点的温度及超温报警，每个测点配有复位按钮，系统整体状态用符号IO域显示。修正：增加单位标签、调整垂直间距、指示灯颜色差异化。",
    "resolution": "1280x800",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Temp_Point1",
      "data_type": "Real",
      "address": "%MD100",
      "comment": "测点1温度"
    },
    {
      "name": "Temp_Point2",
      "data_type": "Real",
      "address": "%MD104",
      "comment": "测点2温度"
    },
    {
      "name": "Temp_Point3",
      "data_type": "Real",
      "address": "%MD108",
      "comment": "测点3温度"
    },
    {
      "name": "Alarm_OH1",
      "data_type": "Bool",
      "address": "%M10.0",
      "comment": "测点1超温报警"
    },
    {
      "name": "Alarm_OH2",
      "data_type": "Bool",
      "address": "%M10.1",
      "comment": "测点2超温报警"
    },
    {
