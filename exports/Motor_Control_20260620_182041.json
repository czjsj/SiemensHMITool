  "scripts": [
    {
      "name": "Sub_Start",
      "language": "VBS",
      "purpose": "按下启动按钮：置位启动命令，复位停止命令",
      "code": "' 启动按钮：发出启动命令\nSmartTags(\"Motor_Start\") = 1\nSmartTags(\"Motor_Stop\") = 0"
    },
    {
      "name": "Sub_Stop",
      "language": "VBS",
      "purpose": "按下停止按钮：置位停止命令，复位启动命令",
      "code": "' 停止按钮：发出停止命令\nSmartTags(\"Motor_Stop\") = 1\nSmartTags(\"Motor_Start\") = 0"
    },
    {
      "name": "Sub_Reset",
      "language": "VBS",
      "purpose": "按下复位按钮：置位复位命令",
      "code": "' 复位按钮：发出故障复位命令\nSmartTags(\"Motor_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 BTN_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"BTN_Start\") = 1\n"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 BTN_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"BTN_Start\") = 0\n"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 BTN_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"BTN_Stop\") = 1\n"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 BTN_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"BTN_Stop\") = 0\n"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 BTN_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"BTN_Reset\") = 1\n"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 BTN_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"BTN_Reset\") = 0\n"
    }
  ],
