  </Screen>
  <VBScripts>
    
      <Purpose>按钮「上行呼叫」— 按下置位 BTN_Elevator_Up</Purpose>
      
        ' 按钮「上行呼叫」按下 — 按下置位
SmartTags("BTN_Elevator_Up") = 1
      
    
    
      <Purpose>按钮「上行呼叫」— 释放复位 BTN_Elevator_Up</Purpose>
      
        ' 按钮「上行呼叫」释放 — 释放复位
SmartTags("BTN_Elevator_Up") = 0
      
    
    
      <Purpose>按钮「下行呼叫」— 按下置位 BTN_Elevator_Down</Purpose>
      
        ' 按钮「下行呼叫」按下 — 按下置位
SmartTags("BTN_Elevator_Down") = 1
      
    
    
      <Purpose>按钮「下行呼叫」— 释放复位 BTN_Elevator_Down</Purpose>
      
        ' 按钮「下行呼叫」释放 — 释放复位
SmartTags("BTN_Elevator_Down") = 0
      
    
    
      <Purpose>切换按钮「急停」— 翻转变量 MEM_Elevator_EmergencyStop</Purpose>
      
        ' 切换按钮「急停」— 翻转变量 MEM_Elevator_EmergencyStop
SmartTags("MEM_Elevator_EmergencyStop") = Not SmartTags("MEM_Elevator_EmergencyStop")
      
    
  </VBScripts>
</Document>