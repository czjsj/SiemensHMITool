      <DisplayName>电梯监控画面</DisplayName>
      <Width>800</Width>
      <Height>480</Height>
    </AttributeList>
    <Tags>
      <Tag Name="IO_Elevator_Floor" DataType="Int">
        <Comment>当前楼层</Comment>
      </Tag>
      <Tag Name="STS_Elevator_Running" DataType="Bool">
        <Comment>电梯运行状态</Comment>
      </Tag>
      <Tag Name="STS_Elevator_Up" DataType="Bool">
        <Comment>上行指示</Comment>
      </Tag>
      <Tag Name="STS_Elevator_Down" DataType="Bool">
        <Comment>下行指示</Comment>
      </Tag>
      <Tag Name="STS_Elevator_DoorOpen" DataType="Bool">
        <Comment>门开状态</Comment>
      </Tag>
      <Tag Name="LMP_Elevator_Fault" DataType="Bool">
        <Comment>故障标志（闪烁）</Comment>
      </Tag>
      <Tag Name="BTN_Elevator_Up" DataType="Bool">
        <Comment>上行呼叫按钮</Comment>
      </Tag>
      <Tag Name="BTN_Elevator_Down" DataType="Bool">
        <Comment>下行呼叫按钮</Comment>
      </Tag>
      <Tag Name="MEM_Elevator_EmergencyStop" DataType="Bool">
        <Comment>急停自保持</Comment>
