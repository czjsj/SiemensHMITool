  "scripts": [
    {
      "name": "Sub_BTN_Start_Press",
      "language": "VBS",
      "purpose": "按钮「启动」— 按下置位 BTN_Motor_Start",
      "code": "' 按钮「启动」按下 — 按下置位\nSmartTags(\"BTN_Motor_Start\") = 1"
    },
    {
      "name": "Sub_BTN_Start_Release",
      "language": "VBS",
      "purpose": "按钮「启动」— 释放复位 BTN_Motor_Start",
      "code": "' 按钮「启动」释放 — 释放复位\nSmartTags(\"BTN_Motor_Start\") = 0"
    },
    {
      "name": "Sub_BTN_Stop_Press",
      "language": "VBS",
      "purpose": "按钮「停止」— 按下置位 BTN_Motor_Stop",
      "code": "' 按钮「停止」按下 — 按下置位\nSmartTags(\"BTN_Motor_Stop\") = 1"
    },
    {
      "name": "Sub_BTN_Stop_Release",
      "language": "VBS",
      "purpose": "按钮「停止」— 释放复位 BTN_Motor_Stop",
      "code": "' 按钮「停止」释放 — 释放复位\nSmartTags(\"BTN_Motor_Stop\") = 0"
    },
    {
      "name": "Sub_BTN_Reset_Press",
      "language": "VBS",
      "purpose": "按钮「复位」— 按下置位 BTN_Motor_Reset",
      "code": "' 按钮「复位」按下 — 按下置位\nSmartTags(\"BTN_Motor_Reset\") = 1"
    },
    {
      "name": "Sub_BTN_Reset_Release",
      "language": "VBS",
      "purpose": "按钮「复位」— 释放复位 BTN_Motor_Reset",
      "code": "' 按钮「复位」释放 — 释放复位\nSmartTags(\"BTN_Motor_Reset\") = 0"
    }
