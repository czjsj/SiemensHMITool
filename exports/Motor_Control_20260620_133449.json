      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动按钮脉冲"
    },
    {
      "name": "BTN_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止按钮脉冲"
    },
    {
