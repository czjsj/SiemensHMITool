  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名密码，硬编码admin/123456，正确则置位在线状态，否则提示",
      "code": "' 登录校验\nDim sUser, sPwd\nsUser = SmartTags(\"Login_Username\")\nsPwd = SmartTags(\"Login_Password\")\nIf sUser = \"admin\" And sPwd = \"123456\" Then\n    SmartTags(\"Login_Online\") = 1\nElse\n    MsgBox \"用户名或密码错误！\", vbExclamation, \"登录失败\"\n    SmartTags(\"Login_Online\") = 0\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录，清除在线状态",
      "code": "' 退出登录\nSmartTags(\"Login_Online\") = 0"
    },
    {
      "name": "Sub_BTN_Login_Press",
      "language": "VBS",
      "purpose": "按钮「登录」— 按下置位 Login_BtnLogin",
      "code": "' 按钮「登录」按下 — 按下置位\nSmartTags(\"Login_BtnLogin\") = 1\n"
    },
    {
      "name": "Sub_BTN_Login_Release",
      "language": "VBS",
      "purpose": "按钮「登录」— 释放复位 Login_BtnLogin",
      "code": "' 按钮「登录」释放 — 释放复位\nSmartTags(\"Login_BtnLogin\") = 0\n"
    },
    {
      "name": "Sub_BTN_Logout_Press",
      "language": "VBS",
      "purpose": "按钮「退出」— 按下置位 Login_BtnLogout",
      "code": "' 按钮「退出」按下 — 按下置位\nSmartTags(\"Login_BtnLogout\") = 1\n"
    },
    {
      "name": "Sub_BTN_Logout_Release",
      "language": "VBS",
      "purpose": "按钮「退出」— 释放复位 Login_BtnLogout",
      "code": "' 按钮「退出」释放 — 释放复位\nSmartTags(\"Login_BtnLogout\") = 0\n"
    }
  ],
