  <VBScripts>
    <Script Name="Sub_Reset1_Press" Language="VBS">
      <Purpose>按下复位1按钮，置位复位变量</Purpose>
      <Code>
        ' 复位测点1报警
SmartTags("Reset_Alarm1") = 1
      </Code>
    </Script>
    <Script Name="Sub_Reset1_Release" Language="VBS">
      <Purpose>释放复位1按钮，清零复位变量</Purpose>
      <Code>
        ' 复位测点1报警释放
SmartTags("Reset_Alarm1") = 0
      </Code>
    </Script>
    <Script Name="Sub_Reset2_Press" Language="VBS">
      <Purpose>按下复位2按钮，置位复位变量</Purpose>
