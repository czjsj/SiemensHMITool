      "name": "Login_UserName",
      "data_type": "String",
      "address": "",
      "comment": "用户名输入"
    },
    {
      "name": "Login_Password",
      "data_type": "String",
      "address": "",
      "comment": "密码输入"
    },
    {
      "name": "Login_Status",
      "data_type": "Bool",
      "address": "%M50.0",
      "comment": "登录状态 true=已登录"
    }
  ],
  "text_lists": [],
  "objects": [
    {
      "id": "TXT_Title",
      "type": "Text",
      "x": 440,
      "y": 60,
      "width": 400,
      "height": 50,
      "text": "操作员登录",
      "font_size": 28,
      "bold": true,
      "color": "#E6EDF3"
    },
    {
      "id": "IO_UserName",
      "type": "IOField",
      "x": 520,
      "y": 200,
      "width": 240,
      "height": 40,
      "mode": "Input",
      "process_tag": "Login_UserName",
      "font_size": 18,
      "label": "用户名",
      "display_format": "String",
      "decimal_digits": 0,
      "unit": ""
    },
    {
      "id": "IO_Password",
      "type": "IOField",
      "x": 520,
      "y": 270,
      "width": 240,
      "height": 40,
      "mode": "Input",
      "process_tag": "Login_Password",
      "font_size": 18,
      "label": "密码",
      "display_format": "String",
      "decimal_digits": 0,
      "unit": ""
    },
    {
      "id": "BTN_Login",
      "type": "Button",
      "x": 380,
      "y": 380,
      "width": 160,
      "height": 50,
      "text": "登录",
      "press_script": "Sub_Login",
      "release_script": null,
      "click_script": null,
      "background_color": "#2BB673"
    },
    {
      "id": "BTN_Logout",
      "type": "Button",
      "x": 740,
      "y": 380,
      "width": 160,
      "height": 50,
