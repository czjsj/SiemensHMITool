      "press_script": "Sub_Logout",
      "release_script": null,
      "click_script": null,
      "background_color": "#E25563"
    },
    {
      "id": "LMP_Online",
      "type": "Indicator",
      "x": 610,
      "y": 480,
      "radius": 28,
      "process_tag": "Login_Status",
      "color_on": "#27D17F",
      "color_off": "#3A4250",
      "blink": false,
      "label": "在线状态"
    }
  ],
  "scripts": [
    {
      "name": "Sub_Login",
      "language": "VBS",
      "purpose": "校验用户名/密码（固定 admin/123456），成功则置位 Login_Status，失败弹出提示",
      "code": "' 登录校验：固定账号 admin / 123456\nDim sUser, sPass\nsUser = SmartTags(\"Login_UserName\")\nsPass = SmartTags(\"Login_Password\")\nIf sUser = \"admin\" And sPass = \"123456\" Then\n    SmartTags(\"Login_Status\") = True\n    HMIRuntime.Trace \"登录成功\"\nElse\n    SmartTags(\"Login_Status\") = False\n    MsgBox \"用户名或密码错误！\", vbExclamation, \"登录失败\"\nEnd If"
    },
    {
      "name": "Sub_Logout",
      "language": "VBS",
      "purpose": "退出登录：清除登录状态与用户输入",
      "code": "' 退出登录：清除状态与输入\nSmartTags(\"Login_Status\") = False\nSmartTags(\"Login_UserName\") = \"\"\nSmartTags(\"Login_Password\") = \"\"\nHMIRuntime.Trace \"用户已退出\""
    }
  ],
  "_warnings": [],
  "_screen_size": {
    "width": 1280,
    "height": 800
  }
}