<?xml version="1.0" encoding="utf-8"?>
<Document xmlns="http://www.siemens.com/automation/SimaticML">
  <Engineering version="V16" />
  <Screen ID="6b11291a-d3e7-4821-99c5-2b6dc808fa6a" Name="Motor_Control">
    <AttributeList>
      <Name>Motor_Control</Name>
      <DisplayName>电机控制画面</DisplayName>
      <Width>1280</Width>
      <Height>800</Height>
    </AttributeList>
    <Tags>
      <Tag Name="Motor_Start" DataType="Bool">
        <Address>%M0.0</Address>
        <Comment>启动命令</Comment>
      </Tag>
      <Tag Name="Motor_Stop" DataType="Bool">
        <Address>%M0.1</Address>
        <Comment>停止命令</Comment>
      </Tag>
      <Tag Name="Motor_Reset" DataType="Bool">
        <Address>%M0.2</Address>
        <Comment>故障复位</Comment>
      </Tag>
      <Tag Name="Motor_Running" DataType="Bool">
        <Address>%M0.3</Address>
        <Comment>运行反馈</Comment>
      </Tag>
      <Tag Name="Motor_Fault" DataType="Bool">
        <Address>%M0.4</Address>
        <Comment>故障标志</Comment>
      </Tag>
      <Tag Name="Motor_Speed" DataType="Real">
        <Address>%MD10</Address>
        <Comment>转速rpm</Comment>
      </Tag>
      <Tag Name="Motor_Mode" DataType="Int">
        <Address>%MW20</Address>
        <Comment>运行模式</Comment>
      </Tag>
    </Tags>
    <TextLists>
      <TextList Name="Motor_Mode_List">
        <Entry Value="0" Text="停止" />
        <Entry Value="1" Text="手动" />
        <Entry Value="2" Text="自动" />
      </TextList>
    </TextLists>
