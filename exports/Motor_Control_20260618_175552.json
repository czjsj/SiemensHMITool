{
  "meta": {
    "screen_name": "Motor_Control",
    "title": "电机控制画面",
    "description": "电机启停控制，兼容 800x480 分辨率。启动/停止/复位按钮，运行/故障指示灯(故障闪烁)，转速显示(rpm)，运行模式显示(停止/手动/自动)。",
    "resolution": "800x480",
    "hmi_type": "Comfort",
    "generation_mode": "auto",
    "template_screen": "",
    "template_xml": ""
  },
  "tags": [
    {
      "name": "Motor_Start",
      "data_type": "Bool",
      "address": "%M0.0",
      "comment": "启动命令"
    },
    {
      "name": "Motor_Stop",
      "data_type": "Bool",
      "address": "%M0.1",
      "comment": "停止命令"
    },
    {
      "name": "Motor_Reset",
      "data_type": "Bool",
      "address": "%M0.2",
      "comment": "故障复位"
    },
    {
      "name": "Motor_Running",
      "data_type": "Bool",
      "address": "%M0.3",
      "comment": "运行反馈"
    },
    {
      "name": "Motor_Fault",
      "data_type": "Bool",
      "address": "%M0.4",
      "comment": "故障标志"
    },
    {
      "name": "Motor_Speed",
      "data_type": "Real",
      "address": "%MD10",
      "comment": "转速 rpm"
    },
    {
      "name": "Motor_Mode",
      "data_type": "Int",
      "address": "%MW20",
      "comment": "运行模式"
    }
  ],
