  <VBScripts>
    
      <Purpose>启动泵和流动动画模拟：泵运行置1，激活流动标志，循环步进画面动画值0~100共10秒后自动停止</Purpose>
      
        ' 启动及流动模拟
Dim i
SmartTags("Pump_Running") = 1
SmartTags("Flow_AnimActive") = 1
For i = 1 To 40
    SmartTags("Flow_Animation") = (SmartTags("Flow_Animation") + 5) Mod 101
    HMIRuntime.Sleep 250
Next
SmartTags("Flow_AnimActive") = 0
SmartTags("Flow_Animation") = 0
SmartTags("Pump_Running") = 0
      
    
    
      <Purpose>立即停止泵和流动动画</Purpose>
      
        ' 停止泵和动画
SmartTags("Pump_Running") = 0
SmartTags("Flow_AnimActive") = 0
SmartTags("Flow_Animation") = 0
      
    
  </VBScripts>
